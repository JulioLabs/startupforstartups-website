{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
{{- /* Every published page is listed. lastmod is the date of the page's last git commit (enableGitInfo in hugo.toml).
       loc is the page's canonical URL (front matter `canonical`), else its permalink.
       To keep a page out, add `sitemap: { disable: true }` to its front matter. */}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range (slice .Site.Home | append .Site.RegularPages) }}
    {{- if not .Sitemap.Disable }}
  <url>
    <loc>{{ .Params.canonical | default .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}

  <!-- Not built by Hugo -->
  <url>
    <loc>https://blog.presencewave.com/</loc>
  </url>
</urlset>
